<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/MainStyles.uss?fileID=7433441132597879392&amp;guid=d64cd3bf55159af439848732d18ccb82&amp;type=3#MainStyles"/>
    
    <ui:VisualElement name="MainInterface" class="main-interface">

        <!-- ===== ФОНОВЫЙ ЛОГОТИП И НАЗВАНИЕ ===== -->
        <ui:VisualElement name="BackgroundBrandContainer" picking-mode="Ignore" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; justify-content: center; align-items: center; flex-direction: column; opacity: 0.12;">
            <ui:VisualElement name="CompanyLogoElement" style="width: 400px; height: 400px; -unity-background-scale-mode: scale-to-fit; margin-bottom: 30px;" />
            <ui:Label text="Моя Компания" name="CompanyNameLabel" style="color: black; font-size: 100px; -unity-font-style: bold; white-space: nowrap;" />
        </ui:VisualElement>
        <!-- ========================================= -->

        <!-- Main Panel -->
        <ui:VisualElement name="MainPanel" class="main-panel">
            <!-- Верхняя панель ресурсов -->
            <ui:VisualElement class="top-bar">
                <ui:VisualElement class="resource-block money-block">
                    <ui:Label text="💰" class="resource-icon" tooltip="Текущий баланс денег"/>
                    <ui:VisualElement class="resource-info">
                        <ui:Label text="" name="MoneyLabel" class="resource-value" tooltip="Текущий баланс денег"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="resource-block reputation-block">
                    <ui:Label text="⭐" class="resource-icon" tooltip="Репутация компании"/>
                    <ui:VisualElement class="resource-info">
                        <ui:Label text="" name="ReputationLabel" class="resource-value" tooltip="Репутация компании"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Кнопка управления брендом -->
                <ui:VisualElement class="resource-block" style="background-color: rgba(0,0,0,0.1); border-radius: 4px; padding: 2px 8px;">
                    <ui:Button text="✏️ Бренд" name="EditBrandButton" style="background-color: transparent; border-width: 0; color: black; -unity-font-style: bold; font-size: 12px;" tooltip="Изменить название и логотип компании" />
                </ui:VisualElement>

                <ui:VisualElement class="resource-block auto-block">
                    <ui:Label text="🚗" class="resource-icon" tooltip="Количество автомобилей, производимых в секунду"/>
                    <ui:VisualElement class="resource-info">
                        <ui:Label text="" name="IncomeLabel" class="resource-value" tooltip="Количество автомобилей, производимых в секунду"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="resource-block parts-block">
                    <ui:Label text="🔧" class="resource-icon" tooltip="Двигатели на складе"/>
                    <ui:VisualElement class="resource-info">
                        <ui:Label text="" name="EngineLabel" class="resource-value" tooltip="Двигатели на складе"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="resource-block parts-block">
                    <ui:Label text="🔩" class="resource-icon" tooltip="Кузова на складе"/>
                    <ui:VisualElement class="resource-info">
                        <ui:Label text="" name="BodyLabel" class="resource-value" tooltip="Кузова на складе"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="resource-block parts-block">
                    <ui:Label text="⚙️" class="resource-icon" tooltip="Колёса на складе"/>
                    <ui:VisualElement class="resource-info">
                        <ui:Label text="" name="WheelsLabel" class="resource-value" tooltip="Колёса на складе"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="resource-block parts-block">
                    <ui:Label text="💻" class="resource-icon" tooltip="Электроника на складе"/>
                    <ui:VisualElement class="resource-info">
                        <ui:Label text="" name="ElectronicsLabel" class="resource-value" tooltip="Электроника на складе"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Машины на складе -->
                <ui:VisualElement class="resource-block parts-block">
                    <ui:Label text="🚗" class="resource-icon" tooltip="Машины на складе"/>
                    <ui:VisualElement class="resource-info">
                        <ui:Label text="" name="CarStockLabel" class="resource-value" tooltip="Количество машин на складе"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Индикатор новостей -->
                <ui:VisualElement class="resource-block news-block" style="background-color: rgba(255, 215, 0, 0.15); border-radius: 4px; padding: 2px 8px;">
                    <ui:Label text="📰" class="resource-icon" tooltip="Активные новости"/>
                    <ui:VisualElement class="resource-info">
                        <ui:Label name="NewsIndicatorLabel" text="Новости" class="resource-value" style="font-size: 12px; color: #996515; -unity-font-style: bold;" tooltip="Нажмите для просмотра новостей"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="top-right">
                    <ui:Label text="" name="SavedDifficultyLabel" class="difficulty-display top-label" tooltip="Текущий уровень сложности"/>
                    <ui:Label text="" name="DateLabel" class="date-display top-label" tooltip="Текущая игровая дата"/>
                    <ui:Label text="" name="SeasonLabel" class="season-display top-label" tooltip="Текущий сезон (влияет на спрос)"/>
                    <ui:Label text="" name="InflationLabel" class="inflation-display top-label" tooltip="Текущий уровень инфляции"/>
                    <ui:VisualElement class="hamburger-wrapper">
                        <ui:Button text="☰" name="HamburgerButton" class="hamburger" tooltip="Открыть главное меню"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button text="Произвести авто" name="ProduceButton" class="produce-button" tooltip="Произвести одну базовую машину"/>
        </ui:VisualElement>

    </ui:VisualElement>

    <!-- ===== ОВЕРЛЕЙ МЕНЮ ===== -->
    <ui:VisualElement name="MenuOverlay" class="overlay">
        <ui:VisualElement style="width: 80%; max-width: 600px; height: 80%; max-height: 700px; background-color: rgb(240,240,240); padding:20px; border-radius:10px; flex-direction:column; border-width: 2px; border-color: #aaa;">
            <ui:VisualElement style="flex-direction:row; justify-content:space-between; margin-bottom:10px; flex-shrink:0;">
                <ui:Label text="📋 Главное меню" style="font-size:20px; color:black; -unity-font-style: bold;"/>
                <ui:Button text="✕" name="CloseMenuButton" style="font-size:20px; background-color:transparent; border-width:0; color:black; -unity-font-style: bold;"/>
            </ui:VisualElement>

            <ui:ScrollView style="flex-grow:1; flex-shrink:1;">
                <ui:VisualElement name="MenuContainer" style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 6px; padding: 8px; background-color: rgba(0,0,0,0.05); border-radius: 6px; width: 100%;">
                    <!-- Колонка 1 -->
                    <ui:VisualElement style="flex-direction: column; gap: 4px; flex-grow: 1; min-width: 120px;">
                        <ui:Label text="🚗 Производство" style="color: #996515; font-size: 12px; -unity-font-style: bold; margin-bottom: 2px;"/>
                        <ui:Button text="Машины" name="OpenCarsButton" class="menu-button-compact" tooltip="Открыть окно производства машин"/>
                        <ui:Button text="Улучшения" name="OpenUpgradeButton" class="menu-button-compact" tooltip="Открыть окно улучшений завода"/>
                        <ui:Button text="Платформы" name="OpenPlatformsButton" class="menu-button-compact" tooltip="Разрабатывайте платформы для удешевления производства"/>
                        <ui:Button text="Произвести авто" name="ProduceButton" class="menu-button-compact" tooltip="Произвести одну базовую машину"/>

                        <ui:Label text="📈 Маркетинг и продажи" style="color: #996515; font-size: 12px; -unity-font-style: bold; margin-top: 4px; margin-bottom: 2px;"/>
                        <ui:Button text="Маркетинг" name="OpenMarketingButton" class="menu-button-compact" tooltip="Открыть окно маркетинговых кампаний"/>
                        <ui:Button text="Рынок" name="OpenMarketVisualizationButton" class="menu-button-compact" tooltip="Рыночная аналитика (доли, графики)"/>
                        <ui:Button text="Кредиты" name="OpenLoansButton" class="menu-button-compact" tooltip="Управление кредитами"/>
                        <ui:Button text="Инвестиции" name="OpenInvestmentsButton" class="menu-button-compact" tooltip="Инвестиции в маркетинг, исследования, производство"/>
                        <ui:Button text="График спроса" name="OpenDemandGraphButton" class="menu-button-compact" tooltip="Показать график изменения спроса"/>
                    </ui:VisualElement>

                    <!-- Колонка 2 -->
                    <ui:VisualElement style="flex-direction: column; gap: 4px; flex-grow: 1; min-width: 120px;">
                        <ui:Label text="🌍 Международная экспансия" style="color: #996515; font-size: 12px; -unity-font-style: bold; margin-bottom: 2px;"/>
                        <ui:Button text="Рынки" name="OpenOfficesButton" class="menu-button-compact" tooltip="Управление зарубежными представительствами"/>
                        <ui:Button text="Патенты" name="OpenPatentsButton" class="menu-button-compact" tooltip="Патентование и лицензирование технологий"/>

                        <ui:Label text="🏆 Прогресс" style="color: #996515; font-size: 12px; -unity-font-style: bold; margin-top: 4px; margin-bottom: 2px;"/>
                        <ui:Button text="Технологии" name="OpenTechButton" class="menu-button-compact" tooltip="Открыть дерево технологий"/>
                        <ui:Button text="Достижения" name="OpenAchievementsButton" class="menu-button-compact" tooltip="Открыть окно достижений"/>
                        <ui:Button text="Конкуренты" name="OpenCompetitorsButton" class="menu-button-compact" tooltip="Открыть окно конкурентов"/>

                        <ui:Label text="📰 Новости" style="color: #996515; font-size: 12px; -unity-font-style: bold; margin-top: 4px; margin-bottom: 2px;"/>
                        <ui:Button text="Новости" name="OpenNewsButton" class="menu-button-compact" tooltip="Текущие рыночные новости"/>

                        <ui:Label text="💾 Сохранение" style="color: #996515; font-size: 12px; -unity-font-style: bold; margin-top: 4px; margin-bottom: 2px;"/>
                        <ui:Button text="Сохранить" name="SaveButton" class="menu-button-compact" tooltip="Сохранить (текущий слот)"/>
                        <ui:Button text="Загрузить" name="LoadButton" class="menu-button-compact" tooltip="Загрузить (текущий слот)"/>
                        <ui:Button text="Новая игра" name="NewGameButton" class="menu-button-compact" tooltip="Начать новую игру"/>
                        <ui:Button text="Выход" name="ExitButton" class="menu-button-compact" tooltip="Закрыть игру" style="background-color: rgba(255, 100, 100, 0.4); color: black; -unity-font-style: bold;"/>

                        <ui:Label text="⚙️ Настройки" style="color: #996515; font-size: 12px; -unity-font-style: bold; margin-top: 4px; margin-bottom: 2px;"/>
                        <ui:Button text="Настройки" name="OpenSettingsButton" class="menu-button-compact" tooltip="Открыть настройки сложности"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ===== ОСТАЛЬНЫЕ ОВЕРЛЕИ ===== -->
    <!-- Welcome -->
    <ui:VisualElement name="WelcomeOverlay" class="overlay">
        <ui:VisualElement name="WelcomeWindow" class="window welcome-window">
            <ui:Label text="Выберите сложность" class="welcome-title" tooltip="Выберите уровень сложности для начала игры"/>
            <ui:Label text="Установите уровень сложности для начала игры:" class="welcome-subtitle"/>
            <ui:Button text="Easy" name="WelcomeEasyButton" class="difficulty-button" tooltip="Лёгкий уровень: цены снижены, конкуренты слабее"/>
            <ui:Button text="Normal" name="WelcomeNormalButton" class="difficulty-button" tooltip="Обычный уровень: стандартные настройки"/>
            <ui:Button text="Hard" name="WelcomeHardButton" class="difficulty-button difficulty-button-last" tooltip="Тяжёлый уровень: цены выше, конкуренты агрессивнее"/>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Cars -->
    <ui:VisualElement name="CarsOverlay" class="overlay">
        <ui:VisualElement name="CarsWindow" style="width: 90%; max-width: 900px; height: 90%; max-height: 800px; background-color: rgb(240, 240, 240); padding: 15px; border-radius: 10px; flex-direction: column; border-width: 2px; border-color: #aaa;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px; flex-shrink: 0;">
                <ui:Label text="Производство машин" style="font-size: 20px; color: black; -unity-font-style: bold;" tooltip="Окно производства автомобилей"/>
                <ui:Button text="✕" name="CloseCarsButton" style="font-size: 20px; background-color: transparent; border-width: 0; color: black; -unity-font-style: bold;" tooltip="Закрыть окно"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px; flex-shrink: 0;">
                <ui:Label text="" style="color: black; -unity-font-style: bold; margin-right: 10px; font-size: 14px;"/>
                <ui:Button text="-" name="DecreaseCountButton" style="width: 28px; height: 28px; font-size: 16px; color: black; -unity-font-style: bold;" tooltip="Уменьшить количество машин для производства"/>
                <ui:IntegerField name="CountInputField" value="1" style="width: 60px; -unity-font-style: bold; margin-left: 5px; margin-right: 5px;" />
                <ui:Button text="+" name="IncreaseCountButton" style="width: 28px; height: 28px; font-size: 16px; color: black; -unity-font-style: bold;" tooltip="Увеличить количество машин для производства"/>
            </ui:VisualElement>

            <ui:VisualElement style="flex-direction: row; margin-bottom: 10px; align-items: center;">
                <ui:TextField name="SearchCarField" label="Поиск:" style="width: 200px; margin-right: 10px; color: black; -unity-font-style: bold;" />
                <ui:DropdownField name="FilterTypeDropdown" label="Тип:" style="width: 150px; color: black; -unity-font-style: bold;" />
                <ui:DropdownField name="SortByDropdown" label="Сортировка:" style="width: 150px; color: black; -unity-font-style: bold;" choices="По умолчанию,По цене (возр),По прибыли (убыв)" />
            </ui:VisualElement>
            <ui:ScrollView name="CarsContainer" style="flex-grow: 1; flex-shrink: 1; min-height: 200px;"/>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Tech -->
    <ui:VisualElement name="TechOverlay" class="overlay">
        <ui:VisualElement name="TechWindow" style="width: 95%; max-width: 1200px; height: 80%; max-height: 700px; min-height: 300px; background-color: rgb(240, 240, 240); padding: 8px 16px 12px 16px; border-radius: 10px; flex-direction: column; align-self: center; border-width: 2px; border-color: #aaa;">
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 4px; flex-shrink: 0;">
                <ui:Label text="Дерево технологий" style="font-size: 18px; color: black; -unity-font-style: bold; flex-grow: 1; -unity-text-align: middle-center;" tooltip="Исследуйте технологии для улучшения производства и открытия новых возможностей"/>
                <ui:Button text="✕" name="CloseTechButton" style="font-size: 18px; background-color: transparent; border-width: 0; color: black; -unity-font-style: bold; padding: 0; margin-left: 8px; flex-shrink: 0; width: 28px; height: 28px;" tooltip="Закрыть окно"/>
            </ui:VisualElement>
            <ui:ScrollView name="TechContainer" class="tech-scroll-view" vertical-scroller-visibility="Auto"/>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Upgrade -->
    <ui:VisualElement name="UpgradeOverlay" class="overlay">
        <ui:VisualElement name="UpgradeWindow" style="width: 90%; max-width: 600px; height: 85%; max-height: 700px; background-color: rgb(240, 240, 240); padding: 16px; border-radius: 10px; flex-direction: column; border-width: 2px; border-color: #aaa;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px; flex-shrink: 0;">
                <ui:Label text="Улучшения завода" style="font-size: 20px; color: black; -unity-font-style: bold;" tooltip="Улучшайте завод, нанимайте инженеров, управляйте деталями"/>
                <ui:Button text="✕" name="CloseUpgradeButton" style="font-size: 20px; background-color: transparent; border-width: 0; color: black; -unity-font-style: bold;" tooltip="Закрыть окно"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; margin-bottom: 8px; flex-shrink: 0;">
                <ui:Button text="Завод" name="UpgradeTabFactoryButton" class="tab-button" style="flex-grow: 1; color: black; -unity-font-style: bold;" tooltip="Управление заводом и инженерами"/>
                <ui:Button text="Детали" name="UpgradeTabPartsButton" class="tab-button" style="flex-grow: 1; color: black; -unity-font-style: bold;" tooltip="Производство и продажа деталей"/>
            </ui:VisualElement>
            <ui:ScrollView name="UpgradeScrollView" style="flex-grow: 1; min-height: 100px;">
                <ui:VisualElement name="UpgradeFactoryContent" style="flex-direction: column;">
                    <ui:Label text="" name="ConveyorLevelLabel" class="upgrade-label" style="font-size: 16px; color: black; -unity-font-style: bold;" tooltip="Текущий уровень конвейера (влияет на пассивный доход)"/>
                    <ui:Button text="" name="BuyConveyorButton" class="upgrade-button" style="margin-bottom: 8px; color: black; -unity-font-style: bold;" tooltip="Улучшить конвейер за деньги"/>
                    <ui:Label text="" name="EngineerCountLabel" class="upgrade-label" style="font-size: 16px; color: black; -unity-font-style: bold;" tooltip="Количество инженеров (ускоряет производство и исследования)"/>
                    <ui:Button text="" name="HireEngineerButton" class="upgrade-button" style="margin-bottom: 8px; color: black; -unity-font-style: bold;" tooltip="Нанять инженера за деньги"/>
                    <ui:Button text="Купить детали (100$)" name="BuyPartsButton" class="upgrade-button" style="margin-bottom: 8px; color: black; -unity-font-style: bold;" tooltip="Купить по 1 детали каждого типа на рынке"/>
                </ui:VisualElement>
                <ui:VisualElement name="UpgradePartsContent" style="flex-direction: column; display: none;">
                    <ui:Label text="Производство деталей" style="color: black; -unity-font-style: bold; font-size: 16px; margin-bottom: 6px;" tooltip="Производите детали на складе (требует инженера и конвейера)"/>
                    <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; gap: 6px;">
                        <ui:Button text="🔧 Двигатель" name="ProduceEngineButton" style="flex-grow: 1; min-width: 80px; color: black; -unity-font-style: bold;" tooltip="Произвести 1 двигатель"/>
                        <ui:Button text="🔩 Кузов" name="ProduceBodyButton" style="flex-grow: 1; min-width: 80px; color: black; -unity-font-style: bold;" tooltip="Произвести 1 кузов"/>
                        <ui:Button text="⚙️ Колёса" name="ProduceWheelsButton" style="flex-grow: 1; min-width: 80px; color: black; -unity-font-style: bold;" tooltip="Произвести 1 комплект колёс"/>
                        <ui:Button text="💻 Электроника" name="ProduceElectronicsButton" style="flex-grow: 1; min-width: 80px; color: black; -unity-font-style: bold;" tooltip="Произвести 1 электронику"/>
                    </ui:VisualElement>
                    <ui:Label text="" name="PartsProductionInfo" style="color: #333; font-size: 12px; margin-top: 4px;" tooltip="Условия производства">
                        Требуется: 1 инженер, 1 уровень конвейера, $10 за деталь
                    </ui:Label>
                    <ui:VisualElement style="height: 2px; background-color: #aaa; margin: 8px 0;"/>
                    <ui:Label text="Продажа деталей" style="color: black; -unity-font-style: bold; font-size: 16px; margin-bottom: 6px;" tooltip="Продавайте детали на рынке по текущей рыночной цене"/>
                    <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; gap: 6px;">
                        <ui:Button text="💰 Продать 🔧" name="SellEngineButton" style="flex-grow: 1; min-width: 80px; background-color: #81c784; color: black; -unity-font-style: bold;" tooltip="Продать 1 двигатель"/>
                        <ui:Button text="💰 Продать 🔩" name="SellBodyButton" style="flex-grow: 1; min-width: 80px; background-color: #81c784; color: black; -unity-font-style: bold;" tooltip="Продать 1 кузов"/>
                        <ui:Button text="💰 Продать ⚙️" name="SellWheelsButton" style="flex-grow: 1; min-width: 80px; background-color: #81c784; color: black; -unity-font-style: bold;" tooltip="Продать 1 комплект колёс"/>
                        <ui:Button text="💰 Продать 💻" name="SellElectronicsButton" style="flex-grow: 1; min-width: 80px; background-color: #81c784; color: black; -unity-font-style: bold;" tooltip="Продать 1 электронику"/>
                    </ui:VisualElement>
                    <ui:Label text="" name="PartsSellInfo" style="color: #333; font-size: 12px; margin-top: 4px;" tooltip="Цена зависит от рыночного спроса и инфляции">
                        Цена зависит от рыночного спроса и инфляции
                    </ui:Label>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Settings -->
    <ui:VisualElement name="SettingsOverlay" class="overlay">
        <ui:VisualElement name="SettingsWindow" class="window settings-window">
            <ui:VisualElement class="window-header">
                <ui:Label text="Настройки сложности" class="window-title" tooltip="Измените сложность игры (применится после перезагрузки)"/>
                <ui:Button text="✕" name="CloseSettingsButton" class="close-button" tooltip="Закрыть окно"/>
            </ui:VisualElement>
            <ui:Label text="Выберите уровень сложности:" class="settings-subtitle"/>
            <ui:Button text="Easy" name="EasyButton" class="difficulty-button" tooltip="Лёгкий уровень: цены снижены, конкуренты слабее"/>
            <ui:Button text="Normal" name="NormalButton" class="difficulty-button" tooltip="Обычный уровень: стандартные настройки"/>
            <ui:Button text="Hard" name="HardButton" class="difficulty-button difficulty-button-last" tooltip="Тяжёлый уровень: цены выше, конкуренты агрессивнее"/>

            <!-- ИСПРАВЛЕНО: Удален дубликат MusicToggle, оставлен один блок с двумя переключателями -->
                        <!-- Настройки (Музыка и Тема на разных строках) -->
            <ui:VisualElement style="flex-direction: column; margin-top: 16px; padding-top: 12px; border-top-width: 1px; border-top-color: #aaa; align-items: flex-start;">
