                <ui:IntegerField name="InvestmentMonthsField" style="width: 60px; color: black; -unity-font-style: bold;" value="6"/>
                <ui:Button text="Инвестировать" name="MakeInvestmentButton" style="background-color: #81c784; color: black; -unity-font-style: bold; padding: 4px 16px;" tooltip="Сделать инвестицию"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Tutorial Overlay -->
    <ui:VisualElement name="TutorialOverlayPanel" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.5); display: none; align-items: center; justify-content: center;">
        <ui:VisualElement style="background-color: rgb(240, 240, 240); padding: 24px; border-radius: 16px; max-width: 500px; min-width: 300px; flex-direction: column; align-items: stretch; border-width: 2px; border-color: #aaa;">
            <ui:Label name="TutorialTitle" style="font-size: 22px; color: #996515; -unity-font-style: bold; margin-bottom: 12px; -unity-text-align: middle-center;" text=""/>
            <ui:Label name="TutorialDescription" style="font-size: 16px; color: #333; -unity-font-style: bold; white-space: normal; margin-bottom: 20px; -unity-text-align: middle-center; padding: 0 8px;" text=""/>
            <ui:VisualElement style="flex-direction: row; justify-content: center; gap: 16px; margin-top: 8px;">
                <ui:Button name="TutorialSkipButton" text="Пропустить" style="background-color: #ccc; color: black; -unity-font-style: bold; font-size: 15px; padding: 10px 24px; border-radius: 8px; border-width: 0;" tooltip="Пропустить обучение"/>
                <ui:Button name="TutorialNextButton" text="Далее" style="background-color: #81c784; color: black; -unity-font-style: bold; font-size: 15px; padding: 10px 24px; border-radius: 8px; border-width: 0;" tooltip="Следующий шаг"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- News Overlay -->
    <ui:VisualElement name="NewsOverlay" class="overlay" style="display: none;">
        <ui:VisualElement style="width: 90%; max-width: 700px; height: 85%; max-height: 800px; background-color: rgb(240, 240, 240); border-radius: 14px; flex-direction: column; padding: 0; overflow: hidden; border-width: 2px; border-color: #aaa;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; padding: 16px 20px; background-color: rgb(220, 220, 220); border-bottom-width: 1px; border-bottom-color: #aaa; flex-shrink: 0;">
                <ui:Label text="📰 Новости рынка" style="font-size: 22px; color: #996515; -unity-font-style: bold;" />
                <ui:Button text="✕" name="CloseNewsButton" style="font-size: 20px; background-color: transparent; border-width: 0; color: black; -unity-font-style: bold; padding: 4px 10px;" />
            </ui:VisualElement>

            <ui:ScrollView style="flex-grow: 1; padding: 16px 20px;">
                <ui:VisualElement name="NewsCurrentBlock" style="flex-direction: column; margin-bottom: 20px;">
                    <ui:VisualElement name="NewsBadge" style="flex-direction: row; align-items: center; align-self: flex-start; padding: 4px 12px; border-radius: 12px; background-color: rgba(255, 215, 0, 0.2); margin-bottom: 12px;">
                        <ui:Label name="NewsBadgeIcon" text="📰" style="font-size: 14px; margin-right: 6px;" />
                        <ui:Label name="NewsBadgeText" text="Событие" style="font-size: 12px; color: #996515; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <ui:Label name="NewsTitleLabel" text="Нет активных новостей" style="font-size: 22px; color: black; -unity-font-style: bold; white-space: normal; margin-bottom: 6px;" />
                    <ui:Label name="NewsDescriptionLabel" text="Рынок стабилен." style="font-size: 14px; color: #333; -unity-font-style: bold; white-space: normal; margin-bottom: 14px;" />

                    <ui:VisualElement name="NewsTimeRow" style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                        <ui:Label text="⏱" style="font-size: 14px; color: #996515; margin-right: 8px;" />
                        <ui:VisualElement style="flex-grow: 1; height: 8px; background-color: rgba(0,0,0,0.1); border-radius: 4px; overflow: hidden;">
                            <ui:VisualElement name="NewsTimeBar" style="width: 0%; height: 100%; background-color: #996515; border-radius: 4px;" />
                        </ui:VisualElement>
                        <ui:Label name="NewsTimeLabel" text="—" style="font-size: 12px; color: #333; -unity-font-style: bold; min-width: 55px; margin-left: 8px; -unity-text-align: middle-right;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="NewsImportanceRow" style="flex-direction: row; align-items: center; margin-bottom: 16px;">
                        <ui:Label text="📊" style="font-size: 14px; color: #996515; margin-right: 8px;" />
                        <ui:VisualElement style="flex-grow: 1; height: 8px; background-color: rgba(0,0,0,0.1); border-radius: 4px; overflow: hidden;">
                            <ui:VisualElement name="NewsImportanceBar" style="width: 0%; height: 100%; background-color: #1b5e20; border-radius: 4px;" />
                        </ui:VisualElement>
                        <ui:Label name="NewsImportanceLabel" text="0%" style="font-size: 12px; color: #333; -unity-font-style: bold; min-width: 55px; margin-left: 8px; -unity-text-align: middle-right;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="NewsActionsContainer" style="flex-direction: column;" />
                </ui:VisualElement>

                <ui:VisualElement name="NewsHistoryDivider" style="height: 1px; background-color: #aaa; margin: 8px 0 16px 0;" />
                <ui:VisualElement name="NewsHistoryBlock" style="flex-direction: column;">
                    <ui:Label text="📜 История новостей" style="font-size: 16px; color: #996515; -unity-font-style: bold; margin-bottom: 10px;" />
                    <ui:VisualElement name="NewsHistoryContainer" style="flex-direction: column;" />
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement style="flex-direction: row; justify-content: flex-end; padding: 12px 20px; background-color: rgb(220, 220, 220); border-top-width: 1px; border-top-color: #aaa; flex-shrink: 0;">
                <ui:Button text="Закрыть" name="CloseNewsButton2" style="background-color: #ccc; color: black; -unity-font-style: bold; padding: 6px 24px; border-radius: 6px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Notifications & Misc -->
    <ui:VisualElement name="NotificationContainer" class="notification-container"/>
    <ui:Label text="" name="EventLabel" class="event-label"/>
    <ui:Label text="" name="VersionLabel" class="version-label"/>
</ui:UXML>